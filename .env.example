# Bu dosyayi .env olarak kopyalayin ve degerleri kendinize gore ayarlayin.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# NOT: bu depoda .env bilincli olarak COMMITLIDIR (private depo, ekip ici ortak
# yapilandirma). Depo public yapilirsa SECRET_KEY ve ADMIN_PASSWORD dondurulmeli.

# --- Ollama / model ---
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b
SYSTEM_PROMPT=You are a helpful assistant. Answer concisely.
TEMPERATURE=0.7
HOST=0.0.0.0
PORT=8000

# --- Auth (production'da MUTLAKA degistir) ---
# SECRET_KEY uretmek icin:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   (veya: openssl rand -hex 32)
# ADMIN_PASSWORD en az 8 karakter olsun; ilk giristen sonra /api/password ile degistirin.
SECRET_KEY=change-me-in-production
SESSION_TTL_HOURS=24
DB_PATH=data/users.db
# Asagidaki ikisi yalnizca kullanici tablosu BOSKEN ilk admini olusturmak icin kullanilir.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# --- RAG: belgeler ve parcalama ---
RAG_DOCS_DIR=data/docs
RAG_TOP_K=4
# keyword = BM25 (Ollama gerekmez) | embed = bge-m3 | hybrid = ikisi + RRF | rerank = cross-encoder
RAG_MODE=hybrid
RAG_EMBED_MODEL=bge-m3
# Parca boyutu ve komsu parcalar arasindaki ortusme (kelime sayisi).
# Kalibre edilmis degerler; degistirirseniz eval/evaluate.py ile yeniden olcun.
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80

# --- Alaka esikleri ---
# Bu esigin altindaki parcalar elenir; guardrail'i besleyen asil ayar budur.
# BM25 skoru 0-~20, kosinus 0-1 araligindadir; bu yuzden moda gore AYRI esik.
# Asagidaki degerler 102 soruluk golden set uzerinde eval/calibrate_hybrid.py
# ile kalibre edildi. Kendi belgelerinizle mutlaka yeniden olcun.
RAG_MIN_SCORE_KEYWORD=6.80
RAG_MIN_SCORE_EMBED=0.535
# Ikisini birden elle ezmek icin (>0 verirseniz ustteki ikisini gecersiz kilar):
# RAG_MIN_SCORE=0.0

# --- Guardrail ---
# Ilgili baglam bulunamazsa modeli hic cagirmadan reddet (halusinasyon onleme).
# true = "bilgi yok" der (belge-QA icin onerilir) | false = eski davranis (modele sorar)
RAG_STRICT=true
RAG_NO_CONTEXT_REPLY=Bu konuda belgelerimde bilgi bulamadim.

# --- Cevaplanabilirlik kontrolu (opsiyonel, ikinci kademe guardrail) ---
# Esigi gecen parcalar geldiginde bile, ikinci bir modele "bu baglam soruyu
# gercekten cevapliyor mu?" diye sorar. Dogrulugu artirir ama her sorguya
# fazladan bir LLM cagrisi ekler; bu yuzden varsayilan KAPALI.
RAG_GROUNDCHECK=false
RAG_GROUNDCHECK_MODEL=qwen3:4b
# Yalnizca guven skoru bu degerin ALTINDA kalan sorgularda calistirilir (secici tetikleme).
RAG_GROUNDCHECK_MIN_CONF=0.60

# --- Rerank modu (yalnizca RAG_MODE=rerank ise kullanilir) ---
# Cross-encoder ile aday yeniden siralama. sentence-transformers kurulu degilse
# sistem uyari basip calismaya devam eder (cokme olmaz).
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANK_POOL=20
# RAG_RERANK_MIN_SCORE=0.5

# --- Ileri duzey / nadiren degistirilir ---
# Metin katmani bos PDF sayfalarinda OCR dene (pytesseract + pdf2image gerekir).
# RAG_OCR=true
# Parca embedding onbelleginin yeri (git'e girmez).
# RAG_CACHE_DIR=data/.rag_cache
# Indeksleme sirasinda tek seferde kac parca embed edilsin.
# RAG_EMBED_BATCH=64
